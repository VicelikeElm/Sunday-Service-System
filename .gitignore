# --- Secrets / credentials / OAuth tokens - never commit these ---
.env
gmail_credentials.json
gmail_token.json
youtube_token.json
youtube_token.json.*
youtube_channel.json

# --- Browser automation profiles - contain cookies, saved logins, cache ---
YouTube_Studio_Profile/
WorshipTools_Planning_Profile/

# --- Python environments ---
venv/
.sss-build-venv/
.sss-build-tools/
__pycache__/
*.pyc

# --- Build / release output - regenerated by the build scripts ---
dist/
build-output/
update-output/
installer-output/

# --- Runtime-generated data - changes every service, not source ---
Logs/
State/
Event History/
Weekly_Backups/
